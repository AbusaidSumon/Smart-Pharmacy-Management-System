<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">


        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="25dp"
            android:background="#174A45">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡"
                android:textSize="45sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADMIN REGISTRATION"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create your administrator account"
                android:textSize="14sp"
                android:textColor="#DCEBE7"
                android:layout_marginTop="5dp"/>

        </LinearLayout>


        <!-- FORM -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="#FFFFFF"
            android:layout_marginTop="20dp">


            <!-- NAME -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#174A45"/>

            <EditText
                android:id="@+id/edtAdminName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter your full name"
                android:inputType="textPersonName"
                android:padding="12dp"/>


            <!-- EMAIL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#174A45"
                android:layout_marginTop="15dp"/>

            <EditText
                android:id="@+id/edtAdminEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter admin email"
                android:inputType="textEmailAddress"
                android:padding="12dp"/>


            <!-- PHONE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#174A45"
                android:layout_marginTop="15dp"/>

            <EditText
                android:id="@+id/edtAdminPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter phone number"
                android:inputType="phone"
                android:padding="12dp"/>


            <!-- PASSWORD -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#174A45"
                android:layout_marginTop="15dp"/>

            <EditText
                android:id="@+id/edtAdminPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Create password"
                android:inputType="textPassword"
                android:padding="12dp"/>


            <!-- CONFIRM PASSWORD -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#174A45"
                android:layout_marginTop="15dp"/>

            <EditText
                android:id="@+id/edtAdminConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Confirm password"
                android:inputType="textPassword"
                android:padding="12dp"/>


            <!-- REGISTER BUTTON -->

            <Button
                android:id="@+id/btnAdminRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Create Admin Account"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#76552D"
                android:layout_marginTop="25dp"/>


            <!-- BACK BUTTON -->

            <Button
                android:id="@+id/btnAdminBack"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Back to Home"
                android:textSize="15sp"
                android:textColor="#76552D"
                android:backgroundTint="#F2EBDD"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Pharmacy • Administrator Portal"
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>