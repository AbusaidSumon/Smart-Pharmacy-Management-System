<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">


        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="25dp"
            android:background="#174A45">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="40sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEARCH MEDICINE"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find medicine from pharmacy inventory"
                android:textSize="14sp"
                android:textColor="#DCEBE7"
                android:layout_marginTop="5dp"/>

        </LinearLayout>


        <!-- SEARCH AREA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:layout_marginTop="16dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#174A45"/>


            <EditText
                android:id="@+id/edtSearchMedicine"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter medicine name"
                android:textSize="15sp"
                android:padding="12dp"
                android:singleLine="true"
                android:inputType="text"
                android:backgroundTint="#287C70"
                android:layout_marginTop="7dp"/>


            <Button
                android:id="@+id/btnSearchMedicine"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🔍  Search Medicine"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#287C70"
                android:layout_marginTop="15dp"/>


            <Button
                android:id="@+id/btnShowAll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Show All Medicines"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#174A45"
                android:backgroundTint="#E1EFEC"
                android:layout_marginTop="8dp"/>

        </LinearLayout>


        <!-- RESULT TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medicine Results"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#174A45"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"/>


        <!-- NO MEDICINE MESSAGE -->

        <TextView
            android:id="@+id/txtNoMedicine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No medicines available"
            android:textSize="15sp"
            android:textColor="#777777"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone"/>


        <!-- MEDICINE RESULTS -->

        <LinearLayout
            android:id="@+id/medicineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>


        <!-- BACK BUTTON -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="←  Back"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#174A45"
            android:backgroundTint="#E1EFEC"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>